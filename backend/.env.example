# Database (PostgreSQL in hosted mode; SQLite also works locally)
DATABASE_URL=sqlite:///./looca_v2.db

# Auth
SECRET_KEY=looca-dev-secret-change-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# VAPI (optional cloud voice path)
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_SERVICES=looca_services
QDRANT_COLLECTION_EPISODES=looca_episodes
QDRANT_COLLECTION_HEALTH_TIMELINE=looca_health_timeline
QDRANT_COLLECTION_OFFLINE_CACHE=looca_offline_cache

# Voyage AI
VOYAGE_API_KEY=

# OpenAI (optional cloud fallback)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_CHAT_MODEL=gpt-4.1-mini

# OpenRouter (optional hosted reasoning fallback)
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=qwen/qwen3-30b-a3b

# Hybrid voice runtime
# auto    = local speech first, cloud fallback when configured
# offline = no cloud fallback; models must already be cached
# cloud   = prefer configured cloud providers
VOICE_MODE=auto
OFFLINE_STRICT=false

# Fast local STT: Whisper auto-detects many languages.
OFFLINE_STT_ENGINE=faster-whisper
OFFLINE_WHISPER_MODEL=base
OFFLINE_WHISPER_DEVICE=cpu
OFFLINE_WHISPER_COMPUTE_TYPE=int8
OFFLINE_CPU_THREADS=4
OFFLINE_MODEL_DIR=

# Extended local STT: set OFFLINE_STT_ENGINE=mms after installing
# requirements-offline.txt. Meta MMS provides very broad multilingual ASR.
MMS_MODEL_ID=facebook/mms-1b-all

# Local TTS
OFFLINE_TTS_ENGINE=auto

# Local LLM through Ollama.
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# CORS / frontend
FRONTEND_URL=http://localhost:3000
